["\"use client\";","import React,{useState}from\"react\";","interface Post{id:number;author:{name:string;username:string;avatar:string;verified:boolean};content:string;image:string|null;likes:number;comments:number;shares:number;time:string;tags:string[];liked:boolean;bookmarked:boolean;}","interface Props{post:Post;onLike:()=>void;onBookmark:()=>void;}","const IG:Record<string,{bg:string;icon:string;label:string}>={","  gradient1:{bg:\"linear-gradient(135deg,#c1121f,#457b9d)\",icon:\"🚀\",label:\"Girişim\"},","  gradient2:{bg:\"linear-gradient(135deg,#2d6a4f,#52b788)\",icon:\"🌱\",label:\"Doğa\"},","  gradient3:{bg:\"linear-gradient(135deg,#1d3557,#457b9d)\",icon:\"💡\",label:\"Teknoloji\"},","};","const PAL=[\"#e63946\",\"#1d3557\",\"#2d6a4f\",\"#e76f51\",\"#457b9d\",\"#c1121f\"];","function avatarBg(n:string){return PAL[n.charCodeAt(0)%PAL.length];}","","export default function PostCard({post,onLike,onBookmark}:Props){","  const [showC,setShowC]=useState(false);","  const [likeAnim,setLA]=useState(false);","  const [cTxt,setCTxt]=useState(\"\");","  const [comments,setComments]=useState<string[]>([]);","  const [shared,setShared]=useState(false);","","  function doLike(){setLA(true);setTimeout(()=>setLA(false),400);onLike();}","  function doComment(){if(!cTxt.trim())return;setComments(x=>[...x,cTxt]);setCTxt(\"\");}","  function doShare(){setShared(true);setTimeout(()=>setShared(false),1500);}","  const img=post.image?IG[post.image]:null;","  const tc=post.comments+comments.length;","  const avBg=avatarBg(post.author.name);","","  return(","    <div style={{background:\"#fff\",borderRadius:16,border:\"1px solid #eef0f2\",boxShadow:\"0 1px 6px rgba(0,0,0,0.06)\",overflow:\"hidden\"}}>","      <div style={{display:\"flex\",alignItems:\"center\",justifyContent:\"space-between\",padding:\"14px 16px 10px\"}}>","        <div style={{display:\"flex\",alignItems:\"center\",gap:10}}>","          <div style={{width:42,height:42,borderRadius:\"50%\",background:avBg,display:\"f