        <div style={{position:\"absolute\",inset:0,background:\"linear-gradient(to top,rgba(0,0,0,0.25),transparent)\"}}></div>","        <div style={{position:\"absolute\",inset:0,display:\"flex\",flexDirection:\"column\",alignItems:\"center\",justifyContent:\"center\",gap:6}}>","          <span style={{fontSize:36}}>{img.icon}</span>","          <span style={{color:\"#fff\",fontWeight:600,fontSize:12,opacity:.9,textShadow:\"0 1px 4px rgba(0,0,0,0.3)\"}}>{img.label}</span>","        </div>","      </div>)}"]